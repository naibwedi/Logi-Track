@model IEnumerable<logirack.Models.Trip>

@{
    ViewData["Title"] = "My Trips";
}

<h1 class="h2">My trips</h1>

<div class="table-responsive">
<table class="table table-striped">
    <caption class="visually-hidden">Your transport requests</caption>
    <thead>
    <tr>
        <th>Trip ID</th>
        <th>From</th>
        <th>To</th>
        <th>Pickup Date</th>
        <th>Status</th>
        <th>Admin Price</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var trip in Model)
    {
        <tr>
            <td>@trip.Id</td>
            <td>@trip.FromCity</td>
            <td>@trip.ToCity</td>
            <td>@trip.PickupTime.ToString("MM/dd/yyyy")</td>
            <td>@trip.Status.ToString()</td>
            <td>@(trip.AdminPrice > 0 ? trip.AdminPrice.ToString("C") : "Pending")</td>
            <td>
                <a asp-action="TripDetails" asp-route-id="@trip.Id" class="btn btn-info btn-sm">Details</a>
                @if (trip.Status == logirack.Models.TripStatus.Completed)
                {
                    <a asp-action="DownloadInvoice" asp-route-id="@trip.Id" class="btn btn-outline-success btn-sm ms-1">Download Invoice</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
