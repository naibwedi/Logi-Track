@{
    ViewData["Title"] = "Dashboard";
}

<div class="role-dashboard">
    <div class="card border-0 shadow-sm role-dashboard-card">
        <div class="card-body p-4 p-md-5">
            <h1 class="h2">Customer dashboard</h1>
            <p class="text-muted mb-4">Welcome, @User.Identity?.Name. Create a shipment request or review your existing trips.</p>
            <div class="button-group">
                <a asp-action="CreateTrip" class="btn btn-primary">Create New Trip</a>
                <a asp-action="MyTrips" class="btn btn-outline-primary">View My Trips</a>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteConfirmModal">
                    Delete Account
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteConfirmModalLabel">Confirm Account Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-danger">Warning: This action cannot be undone</p>
                <p>Are you sure you want to delete your account? This will:</p>
                <ul>
                    <li>Remove your personal information</li>
                    <li>Archive your trip history</li>
                    <li>Permanently deactivate your account</li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="CustomerDelete" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete My Account</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" /> }
