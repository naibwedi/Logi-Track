@model IEnumerable<logirack.Models.Admin>

@{
ViewBag.Title = "Admin List";
Layout = "_Layout";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div><h1 class="h2 mb-1">Admin list</h1><p class="text-muted mb-0">Manage accounts with administrative access.</p></div>
    <a asp-action="CreateAdmin" class="btn btn-primary">Create new admin</a>
</div>

@if (TempData["Success"] != null)
{
<div class="alert alert-success">
    @TempData["Success"]
</div>
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger">
    @TempData["Error"]
</div>
}

@if (!Model.Any())
{
<div class="alert alert-info" role="status">No administrator accounts have been created yet.</div>
}
else
{
<div class="table-responsive border rounded">
<table class="table table-striped">
    <caption class="visually-hidden">Administrator accounts</caption>
    <thead>
    <tr>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Email</th>
        <th>Phone Number</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var admin in Model)
    {
    <tr>
        <td>@admin.FirstName</td>
        <td>@admin.LastName</td>
        <td>@admin.Email</td>
        <td>@admin.PhoneNumber</td>
        <td>
            <a asp-action="EditAdmin" asp-route-id="@admin.Id" class="btn btn-warning btn-sm">Edit</a>

            <form asp-action="DeleteAdmin" asp-route-id="@admin.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this admin?');" style="display:inline;">
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            </form>
        </td>
    </tr>
    }
    </tbody>
</table>
</div>
}

@section Scripts {
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
