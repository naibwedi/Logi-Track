@model logirack.Models.ViewModel.TripDetailsViewModel

@{
    ViewData["Title"] = "Trip Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isLiveTrackable = Model.Status == TripStatus.Assigned || Model.Status == TripStatus.InProgress || Model.Status == TripStatus.Completed;
}

<div class="container my-4">
    <div class="card">
        <!-- Header -->
        <div class="card-header">
            <h1 class="h4">Trip Details #@Model.TripId</h1>
        </div>

        <div class="card-body">
            <!-- Customer Information -->
            <div class="mb-4">
                <h2 class="h5">Customer Information</h2>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Name:</strong> @Model.CustomerName</p>
                        <p><strong>Email:</strong> @Model.CustomerEmail</p>
                        <p><strong>Phone:</strong> @Model.CustomerPhone</p>
                    </div>
                </div>
            </div>

            <!-- Trip Information -->
            <div class="mb-4">
                <h2 class="h5">Trip Information</h2>
                <div class="row">
                    <div class="col-md-6">
                        <h5>Pickup</h5>
                        <p>City: @Model.FromCity</p>
                        <p>Address: @Model.FromAddress</p>
                        <p>Zip: @Model.FromZipCode</p>
                    </div>
                    <div class="col-md-6">
                        <h5>Delivery</h5>
                        <p>City: @Model.ToCity</p>
                        <p>Address: @Model.ToAddress</p>
                        <p>Zip: @Model.ToZipCode</p>
                    </div>
                </div>
            </div>

            <!-- Cargo Details -->
            <div class="mb-4">
                <h2 class="h5">Cargo Details</h2>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Weight:</strong> @Model.Weight kg</p>
                        <p><strong>Volume:</strong> @Model.Volume m³</p>
                        <p><strong>Distance:</strong> @Model.Distance km</p>
                        <p><strong>Goods Type:</strong> @Model.GoodTypes</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Pickup Time:</strong> @Model.PickupDate.ToString("g")</p>
                        <p><strong>Estimated Price:</strong> @Model.EstimatedPrice NOK</p>
                        <p><strong>Status:</strong> 
                            <span class="badge 
                                @(Model.Status == TripStatus.Requested ? "badge-warning" : 
                                Model.Status == TripStatus.ApprovedByCustomer ? "badge-success" : 
                                "badge-danger")">
                                @Model.Status
                            </span>
                        </p>
                    </div>
                </div>
            </div>

            @if (isLiveTrackable)
            {
                <div class="mb-4">
                    <h2 class="h5">Live Route & Driver Tracking</h2>
                    <div id="trip-map" style="height: 420px; width: 100%; border-radius: 8px; border: 1px solid #dee2e6;"
                         data-trip-id="@Model.TripId"
                         data-from-city="@Model.FromCity"
                         data-to-city="@Model.ToCity"
                         data-from-address="@Model.FromAddress"
                         data-to-address="@Model.ToAddress"
                         data-start-lat="@Model.StartLatitude.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                         data-start-lng="@Model.StartLongitude.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                         data-dest-lat="@Model.DestinationLatitude.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                         data-dest-lng="@Model.DestinationLongitude.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                         data-current-lat="@Model.CurrentLatitude.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                         data-current-lng="@Model.CurrentLongitude.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    </div>
                    <div class="mt-2 text-muted small d-flex justify-content-between">
                        <div>
                            <strong>Current Position:</strong> Lat <span id="current-lat-val">@Model.CurrentLatitude.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)</span>, 
                            Lng <span id="current-lng-val">@Model.CurrentLongitude.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)</span>
                        </div>
                        <span id="tracking-status-badge" class="badge @(Model.Status == TripStatus.InProgress ? "bg-success" : "bg-primary")">
                            @(Model.Status == TripStatus.InProgress ? "Live In-Progress" : Model.Status.ToString())
                        </span>
                    </div>
                </div>
            }

            <div class="mb-4">
                <h2 class="h5">Admin Actions</h2>
                <div class="row">
                    <div class="col-md-12">
                        @if (Model.Status == TripStatus.Requested)
                        {
                        <form asp-controller="Admin"
                              asp-action="ReviewTrip"
                              method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="tId" value="@Model.TripId" />
                            <div class="btn-group">
                                <button type="submit"
                                        name="isApproved"
                                        value="true"
                                        class="btn btn-success me-2">
                                    Approve Trip
                                </button>
                                <button type="submit"
                                        name="isApproved"
                                        value="false"
                                        class="btn btn-danger">
                                    Reject Trip
                                </button>
                            </div>
                        </form>
                        }
                        @if (Model.Status == TripStatus.ApprovedByAdmin)
                        {
                        <a href="@Url.Action("SetPrice", new { id = Model.TripId })"
                           class="btn btn-primary">
                            Set Final Price
                        </a>
                        }
                        @if (Model.Status == TripStatus.ApprovedByCustomer)
                        {
                        <a href="@Url.Action("AssignTrip", "Admin", new { id = Model.TripId })"
                           class="btn btn-primary">
                            Assign to Driver
                        </a>
                        }
                        @if (Model.Status == TripStatus.Completed)
                        {
                        <a asp-action="DownloadInvoice" asp-route-id="@Model.TripId"
                           class="btn btn-outline-success">
                            Download PDF Invoice
                        </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (isLiveTrackable)
{
    @section Scripts {
        <script src="~/js/tripTracking.js" asp-append-version="true"></script>
    }
}