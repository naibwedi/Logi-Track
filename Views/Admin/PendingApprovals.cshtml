@model List<logirack.Models.ApplicationUser>

@{ ViewData["Title"] = "Pending approvals"; }

<h1 class="h2">Pending approvals</h1>

<div class="table-responsive">
<table class="table align-middle">
    <caption class="visually-hidden">Customers awaiting account approval</caption>
    <thead>
    <tr>
        <th>Email</th>
        <th>Company Name</th>
        <th>Approve</th>
        <th>Do Not Approve</th> <!-- Ny kolonne -->
    </tr>
    </thead>
    <tbody>
    @if (!Model.Any())
    {
        <tr><td colspan="4" class="text-center text-muted py-4">No customers are waiting for approval.</td></tr>
    }
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.Email</td>
            <td>@user.CompanyName</td>
            <td>
                <form asp-action="ApproveUser" method="post">
                    <input type="hidden" name="userId" value="@user.Id" />
                    <input type="hidden" name="approve" value="true" />
                    <button type="submit" class="btn btn-primary">Approve</button>
                </form>
            </td>
            <td>
                <form asp-action="ApproveUser" method="post">
                    <input type="hidden" name="userId" value="@user.Id" />
                    <input type="hidden" name="approve" value="false" />
                    <button type="submit" class="btn btn-danger">Do Not Approve</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
