@model IEnumerable<logirack.Models.Driver>

<table class="table table-hover table-bordered">
    <thead class="thead-dark">
    <tr>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Email</th>
        <th>Phone Number</th>
        <th>Price per Km</th>
        <th>Payment Frequency</th>
        <th>CDL / DOT Medical Card</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @if (!Model.Any())
    {
    <tr>
        <td colspan="7" class="text-center">No drivers found.</td>
    </tr>
    }
    else
    {
    @foreach (var driver in Model)
    {
    <tr>
        <td>@driver.FirstName</td>
        <td>@driver.LastName</td>
        <td>@driver.Email</td>
        <td>@driver.PhoneNumber</td>
        <td>@driver.PricePerKm</td>
        <td>@driver.PaymentFreq</td>
        <td>
            @if (!string.IsNullOrWhiteSpace(driver.CdlNumber))
            {
                <div class="small font-monospace">CDL: @driver.CdlNumber (@(driver.CdlState ?? "US"))</div>
            }
            @if (driver.MedicalCardExpirationDate.HasValue)
            {
                var medExpired = logirack.Services.ComplianceService.IsMedicalCardExpired(driver, DateTime.UtcNow);
                <span class="badge @(medExpired ? "bg-danger" : "bg-success")">
                    Med: @driver.MedicalCardExpirationDate.Value.ToString("yyyy-MM-dd") @(medExpired ? "(EXPIRED)" : "")
                </span>
            }
            else
            {
                <span class="badge bg-secondary">Med Card Not Set</span>
            }
        </td>
        <td>
            <a asp-action="EditDriver" asp-route-id="@driver.Id" class="btn btn-warning btn-sm">Edit</a>
            <form asp-action="DeleteDriver" asp-route-id="@driver.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this driver?');">
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            </form>
        </td>
    </tr>
    }
    }
    </tbody>
</table>
