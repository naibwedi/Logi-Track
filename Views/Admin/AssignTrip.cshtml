@model logirack.Models.ViewModel.AssignTripViewModel

<h2>Assign Trip</h2>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Trip Details</h5>
        <p>From: @Model.FromCity</p>
        <p>To: @Model.ToCity</p>
        <p>Weight: @Model.Weight kg</p>
        <p>Distance: @Model.Distance km</p>
    </div>
</div>

<form asp-controller="Admin" asp-action="AssignTrip" method="post">    <input type="hidden" asp-for="TripId" />
    <input type="hidden" asp-for="FromCity" />
    <input type="hidden" asp-for="ToCity" />
    <input type="hidden" asp-for="Weight" />
    <input type="hidden" asp-for="Distance" />
    
    <div class="form-group mb-3">
        <label asp-for="DriverId">Select Driver</label>
        <select asp-for="DriverId" class="form-control" id="driverSelect">
            <option value="">Choose a driver...</option>
            @foreach (var driver in Model.AvailableDrivers)
            {
                <option value="@driver.Id" 
                        data-price-per-km="@driver.PricePerKm" 
                        data-name="@driver.FirstName @driver.LastName">
                    @driver.FirstName @driver.LastName (@driver.Email) - @driver.PricePerKm.ToString("C")/km
                </option>
            }
        </select>
        <span asp-validation-for="DriverId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="VehicleId">Select Tractor Unit</label>
        <select asp-for="VehicleId" class="form-control" id="vehicleSelect">
            <option value="">Choose a tractor unit...</option>
            @foreach (var vehicle in Model.AvailableVehicles)
            {
                <option value="@vehicle.Id">
                    Unit @vehicle.UnitNumber — @vehicle.Year @vehicle.Make @vehicle.Model (Plate: @vehicle.LicensePlate, VIN: @vehicle.Vin)
                </option>
            }
        </select>
        <span asp-validation-for="VehicleId" class="text-danger"></span>

        <div class="card border-0 bg-light p-3 mt-3">
            <h5 class="h6 fw-bold mb-3">Broker &amp; Load Settlement (12% Dispatch / 88% Driver Split)</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="BrokerId" class="form-label">Freight Broker (MC#)</label>
                    <select asp-for="BrokerId" class="form-control" id="brokerSelect">
                        <option value="">Direct Shipper / Select Broker...</option>
                        @foreach (var broker in Model.AvailableBrokers)
                        {
                            <option value="@broker.Id" data-blacklisted="@broker.IsBlacklisted.ToString().ToLowerInvariant()" data-reason="@broker.BlacklistReason">
                                @broker.CompanyName (@broker.DisplayMc) @(broker.IsBlacklisted ? "— [BAD BROKER / DO NOT LOAD]" : "")
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="InvoiceNumber" class="form-label">Invoice #</label>
                    <input asp-for="InvoiceNumber" class="form-control font-monospace" placeholder="IN001" />
                </div>
                <div class="col-md-3">
                    <label asp-for="BrokerLoadNumber" class="form-label">Broker Load #</label>
                    <input asp-for="BrokerLoadNumber" class="form-control font-monospace" placeholder="23044790" />
                </div>
                <div class="col-md-3">
                    <label asp-for="RateConfirmationAmount" class="form-label">Rate Con ($)</label>
                    <input asp-for="RateConfirmationAmount" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-3">
                    <label asp-for="DetentionFee" class="form-label">Detention ($)</label>
                    <input asp-for="DetentionFee" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-3">
                    <label asp-for="LumperFee" class="form-label">Lumper ($)</label>
                    <input asp-for="LumperFee" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Deductions" class="form-label">Deductions ($)</label>
                    <input asp-for="Deductions" class="form-control" type="number" step="0.01" />
                </div>
            </div>
        </div>
    </div>

    <div id="paymentInfo" style="display:none;" class="alert alert-info mt-3">
        <p>Estimated Payment: <span id="estimatedPayment"></span></p>
        <p>Based on:</p>
        <ul>
            <li>Driver's Rate: <span id="driverRate"></span>/km</li>
            <li>Trip Distance: @Model.Distance km</li>
        </ul>
    </div>

    <button type="submit" class="btn btn-primary">Assign Trip</button>
    <a asp-action="TripDetails" asp-route-id="@Model.TripId" class="btn btn-secondary">Back to Details</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            console.log('Script loaded');
            
            $('#driverSelect').change(function() {
                var selectedOption = $(this).find('option:selected');
                var pricePerKm = selectedOption.data('price-per-km');
                var distance = @Model.Distance;
                
                if(pricePerKm) {
                    var totalPayment = pricePerKm * distance;
                    $('#driverRate').text(pricePerKm.toFixed(2) + ' NOK');
                    $('#estimatedPayment').text(totalPayment.toFixed(2) + ' NOK');
                    $('#paymentInfo').show();
                } else {
                    $('#paymentInfo').hide();
                }
            });

            $('form').on('submit', function(e) {
                console.log('Form submitting...');
                if (!$('#driverSelect').val()) {
                    e.preventDefault();
                    alert('Please select a driver');
                    return false;
                }
            });
        });
    </script>
}