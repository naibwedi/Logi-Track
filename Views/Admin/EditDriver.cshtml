@model logirack.Models.ViewModel.EditDriverViewModel

@{
ViewBag.Title = "Edit Driver";
Layout = "_Layout";
}

<h2>Edit Driver</h2>

@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<form asp-action="EditDriver" method="post" class="w-50">
    @Html.HiddenFor(model => model.id)

    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PricePerKm"></label>
        <input asp-for="PricePerKm" class="form-control" />
        <span asp-validation-for="PricePerKm" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="PaymentFreq"></label>
        <select asp-for="PaymentFreq" class="form-control" asp-items="Html.GetEnumSelectList<logirack.Models.PaymentFreq>()"></select>
        <span asp-validation-for="PaymentFreq" class="text-danger"></span>

        <div class="row g-2 mt-2 mb-2">
            <div class="col-md-8 form-group">
                <label asp-for="CdlNumber"></label>
                <input asp-for="CdlNumber" class="form-control font-monospace" />
                <span asp-validation-for="CdlNumber" class="text-danger"></span>
            </div>
            <div class="col-md-4 form-group">
                <label asp-for="CdlState"></label>
                <input asp-for="CdlState" class="form-control text-uppercase" maxlength="2" />
                <span asp-validation-for="CdlState" class="text-danger"></span>
            </div>
            <div class="col-md-6 form-group">
                <label asp-for="CdlExpirationDate"></label>
                <input asp-for="CdlExpirationDate" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
                <span asp-validation-for="CdlExpirationDate" class="text-danger"></span>
            </div>
            <div class="col-md-6 form-group">
                <label asp-for="MedicalCardExpirationDate"></label>
                <input asp-for="MedicalCardExpirationDate" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
                <span asp-validation-for="MedicalCardExpirationDate" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- Checkbox for IsAvailable -->
    <div class="form-check">
        <input asp-for="IsAvailable" class="form-check-input" type="checkbox" />
        <label asp-for="IsAvailable" class="form-check-label"></label>
        <span asp-validation-for="IsAvailable" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Update driver</button>
    <a asp-action="DriverManagment" class="btn btn-secondary mt-3">Cancel</a>
</form>

@section Scripts {
@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
