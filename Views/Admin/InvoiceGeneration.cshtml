@model IEnumerable<logirack.Models.DriverTrip>
@{ ViewData["Title"] = "Completed-trip invoices"; }

<h1>Completed-trip invoices</h1>
<p>This report contains the completed work ready for payment processing.</p>
<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead><tr><th>Trip</th><th>Driver</th><th>Route</th><th>Completed</th><th>Driver payment</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>#@item.TripId</td>
            <td>@item.Driver?.Email</td>
            <td>@item.Trip?.FromCity → @item.Trip?.ToCity</td>
            <td>@item.CompletionDate?.ToString("g")</td>
            <td>@item.DriverPayment.ToString("C")</td>
            <td>
                <a asp-action="DownloadInvoice" asp-route-id="@item.TripId" class="btn btn-outline-primary btn-sm">
                    Download PDF Invoice
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
@if (!Model.Any()) { <div class="alert alert-info" role="status">No completed trips are ready.</div> }
