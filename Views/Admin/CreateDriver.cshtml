@model logirack.Models.ViewModel.CreateDriverViewModel


@{ ViewData["Title"] = "Create driver"; }
<h1>Create driver</h1>
<p class="text-muted">Create an approved driver account and share the initial password through a secure channel.</p>
<form asp-action="CreateDriver" method="post" class="mx-auto" style="max-width: 42rem">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DriverEmail"></label>
        <input asp-for="DriverEmail" class="form-control" />
        <span asp-validation-for="DriverEmail" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DateOfBirth"></label>
        <input asp-for="DateOfBirth" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PricePerKm"></label>
        <input asp-for="PricePerKm" class="form-control" />
        <span asp-validation-for="PricePerKm" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PaymentFreq"></label>
        <select asp-for="PaymentFreq" class="form-control"
                asp-items="Html.GetEnumSelectList<logirack.Models.PaymentFreq>()">
        </select>
        <span asp-validation-for="PaymentFreq" class="text-danger"></span>
    </div>

    <div class="row g-2 mb-2">
        <div class="col-md-8 form-group">
            <label asp-for="CdlNumber"></label>
            <input asp-for="CdlNumber" class="form-control font-monospace" placeholder="e.g. R420-8819-2201" />
            <span asp-validation-for="CdlNumber" class="text-danger"></span>
        </div>
        <div class="col-md-4 form-group">
            <label asp-for="CdlState"></label>
            <input asp-for="CdlState" class="form-control text-uppercase" maxlength="2" placeholder="IL" />
            <span asp-validation-for="CdlState" class="text-danger"></span>
        </div>
        <div class="col-md-6 form-group">
            <label asp-for="CdlExpirationDate"></label>
            <input asp-for="CdlExpirationDate" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
            <span asp-validation-for="CdlExpirationDate" class="text-danger"></span>
        </div>
        <div class="col-md-6 form-group">
            <label asp-for="MedicalCardExpirationDate"></label>
            <input asp-for="MedicalCardExpirationDate" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
            <span asp-validation-for="MedicalCardExpirationDate" class="text-danger"></span>
        </div>
    </div>
    </div>

    <div class="form-group">
        <label asp-for="Password"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create Driver</button>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
