@model IEnumerable<logirack.Models.ViewModel.TripRequestViewModel>

@{ ViewData["Title"] = "Trip requests"; }

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Trip requests</h1>
        <p class="text-muted mb-0">Review shipment requests and open their assignment details.</p>
    </div>
    <div>
        <label for="statusFilter" class="form-label">Filter by status</label>
        <select id="statusFilter" class="form-select" onchange="updateFilter(this.value)">
            <option value="">All statuses</option>
            @foreach (var status in Enum.GetValues(typeof(TripStatus)))
            {
            <option value="@status" selected="@(ViewBag.CurrentFilter == status.ToString() ? "selected" : null)">@status</option>
            }
        </select>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="status">No trip requests match this filter.</div>
}
else
{
<div class="table-responsive border rounded">
    <table class="table table-hover align-middle mb-0">
        <caption class="visually-hidden">Trip requests</caption>
        <thead class="table-light">
        <tr>
            <th scope="col">ID</th>
            <th scope="col">Customer</th>
            <th scope="col">Route</th>
            <th scope="col">Load</th>
            <th scope="col">Price</th>
            <th scope="col">Status</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var trip in Model)
        {
        <tr>
            <td>#@trip.TripId</td>
            <td>@trip.CustomerName</td>
            <td><strong>@trip.FromCity</strong><span class="text-muted"> to </span><strong>@trip.ToCity</strong></td>
            <td>@trip.Weight kg<br><span class="text-muted small">@trip.Distance km</span></td>
            <td>@trip.EstimatedPrice.ToString("N2") NOK</td>
            <td><span class="badge @(trip.Status == TripStatus.Requested ? "bg-warning text-dark" : trip.Status == TripStatus.ApprovedByCustomer ? "bg-success" : "bg-secondary")">@trip.Status</span></td>
            <td class="text-end"><a asp-action="TripDetails" asp-route-id="@trip.TripId" class="btn btn-sm btn-outline-primary">View details</a></td>
        </tr>
        }
        </tbody>
    </table>
</div>
}

@section Scripts {
<script>
    function updateFilter(status) {
        window.location.href = '@Url.Action("TripRequests")?sFilter=' + encodeURIComponent(status);
    }
</script>
}
