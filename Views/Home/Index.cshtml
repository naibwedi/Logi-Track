<!-- Hero Section -->
<section class="hero">
    <div class="hero-content">
        <h1>Effortless Fleet Management</h1>
        <p>Coordinate transport requests, pricing, driver assignments, and delivery status in one place.</p>
        <div class="hero-buttons">
            <a class="btn learn-more" asp-controller="Home" asp-action="Services">Learn More</a>
            <a class="btn get-started" asp-area="Identity" asp-page="/Account/Register">Get Started</a>
        </div>
    </div>
</section>

<!-- Services Section -->
<section class="services">
    <h2>Our Services</h2>
    <div class="service-cards">
        <div class="card">
            <img src="~/images/gpstracking.jpg" alt="GPS Tracking">
            <h3>Trip Status Updates</h3>
            <p>Follow each request from review and pricing through assignment and completion.</p>
        </div>
        <div class="card">
            <img src="~/images/RouteOptimization.jpg" alt="Dispatch planning">
            <h3>Driver Assignment</h3>
            <p>Match approved, available drivers with scheduled transport work.</p>
        </div>
        <div class="card">
            <img src="~/images/hazard_logo.jpg" alt="Driver Safety">
            <h3>Payment Records</h3>
            <p>Prepare completed driver work for transparent payment processing.</p>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features">
    <h2>Why Choose Us</h2>
    <div class="feature-list">
        <div class="feature-item">
            <i class="icon fa fa-tachometer"></i>
            <h3>High Performance</h3>
            <p>Experience seamless and fast fleet management with our cutting-edge technology.</p>
        </div>
        <div class="feature-item">
            <i class="icon fa fa-shield"></i>
            <h3>Role-Based Access</h3>
            <p>Customers, drivers, administrators, and super administrators see their relevant tools.</p>
        </div>
        <div class="feature-item">
            <i class="icon fa fa-cogs"></i>
            <h3>Customizable Solutions</h3>
            <p>Tailor our services to meet your specific business needs.</p>
        </div>
    </div>
</section>

<!-- Testimonials Section -->
<section class="testimonials">
    <h2>What Our Clients Say</h2>
    <div class="testimonial-cards">
        <div class="testimonial">
            <p>"Truck Tracker has transformed our fleet operations. The real-time insights are invaluable."</p>
            <h4>- Oobay, Fleet Manager</h4>
        </div>
        <div class="testimonial">
            <p>"The user-friendly interface makes managing our drivers and vehicles a breeze."</p>
            <h4>- Elyas, Operations Director</h4>
        </div>
    </div>
</section>

<!-- Call to Action Section -->
<section class="cta">
    <h2>Ready to Optimize Your Fleet with us!</h2>
    <a class="btn learn-more" asp-controller="Home" asp-action="Services">Learn More</a>
    @if (User.Identity?.IsAuthenticated != true)
    {


        <button class="btn btn-secondary cta-button" onclick="window.location.href='/Identity/Account/Register'">Register</button>
    }
</section>

<!-- Footer Section -->
<footer class="footer">
    <div class="footer-content">
        <div class="footer-section about">
            <h3>About LogiTrack</h3>
            <p>A focused transport administration system for customers, dispatchers, and drivers.</p>
        </div>
        <div class="footer-section links">
            <h3>Quick Links</h3>
            <ul>
                <li><a href="~/">Home</a></li>
                <li><a asp-controller="Home" asp-action="Services">Services</a></li>
                <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
            </ul>
        </div>
        <div class="footer-section contact-form">
            <h3>Contact Us</h3>
            <form asp-controller="Home" asp-action="Contact" method="post">
                <input type="email" name="email" placeholder="Your Email Address" required>
                <textarea name="message" rows="4" placeholder="Your Message" required></textarea>
                <button type="submit" class="btn">Send</button>
            </form>
        </div>
    </div>
    <div class="footer-bottom">
        &copy; @DateTime.UtcNow.Year LogiTrack
    </div>
</footer>
