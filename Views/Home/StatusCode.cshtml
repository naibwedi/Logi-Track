@{
    var code = (int?)ViewData["StatusCode"] ?? 500;
    ViewData["Title"] = code == 404 ? "Page not found" : "Request error";
}

<section class="text-center py-5" aria-labelledby="status-heading">
    <p class="display-1 fw-bold text-primary mb-2">@code</p>
    <h1 id="status-heading" class="h2">@(code == 404 ? "Page not found" : "We could not complete that request")</h1>
    <p class="text-muted mx-auto mb-4" style="max-width: 36rem">
        @(code == 404
            ? "The address may be incorrect, or the page may have moved."
            : "Please return to a safe page and try again.")
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return home</a>
</section>
