@model IEnumerable<logirack.Models.ViewModel.TripDetailsViewModel>

<h2>Your Trip Log</h2>

<table class="table">
    <thead>
    <tr>
        <th>Trip ID</th>
        <th>From</th>
        <th>To</th>
        <th>Distance (km)</th>
        <th>Weight (kg)</th>
        <th>Pickup Date</th>
        <th>Status</th>
        <th>Payment (Admin Price)</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var trip in Model)
    {
        <tr>
            <td>@trip.TripId</td>
            <td>@trip.FromCity</td>
            <td>@trip.ToCity</td>
            <td>@trip.Distance</td>
            <td>@trip.Weight</td>
            <td>@trip.PickupDate.ToString("dd MMM yyyy")</td>
            <td>@trip.Status</td>
            <td>@trip.AdminPrice.ToString("C")</td>
        </tr>
    }
    </tbody>
</table>