@model IEnumerable<logirack.Models.ViewModel.TripDetailsViewModel>

@{ ViewData["Title"] = "Trip log"; }

<h1 class="h2">Your trip log</h1>

@if (!Model.Any())
{
    <div class="alert alert-info" role="status">No trip history is available yet.</div>
}
else
{
<div class="table-responsive">
<table class="table">
    <caption class="visually-hidden">Your current and completed trips</caption>
    <thead>
    <tr>
        <th>Trip ID</th>
        <th>From</th>
        <th>To</th>
        <th>Distance (km)</th>
        <th>Weight (kg)</th>
        <th>Pickup Date</th>
        <th>Status</th>
        <th>Payment (Admin Price)</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var trip in Model)
    {
        <tr>
            <td>@trip.TripId</td>
            <td>@trip.FromCity</td>
            <td>@trip.ToCity</td>
            <td>@trip.Distance</td>
            <td>@trip.Weight</td>
            <td>@trip.PickupDate.ToString("dd MMM yyyy")</td>
            <td>@trip.Status</td>
            <td>@trip.AdminPrice.ToString("C")</td>
        </tr>
    }
    </tbody>
</table>
</div>
}
