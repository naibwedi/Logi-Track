@{ ViewData["Title"] = "Driver dashboard"; }

<h1>Driver dashboard</h1>
<p class="lead">Review assigned work, complete deliveries, and track payment records.</p>
<div class="row g-4 mt-2">
    <div class="col-md-4">
        <section class="card h-100"><div class="card-body"><h2 class="h4">Current trips</h2><p>See active assignments and mark completed deliveries.</p><a asp-action="CurrentTrips" class="btn btn-primary">View current trips</a></div></section>
    </div>
    <div class="col-md-4">
        <section class="card h-100"><div class="card-body"><h2 class="h4">Trip history</h2><p>Review completed and previous assignments.</p><a asp-action="TripLog" class="btn btn-primary">Open trip history</a></div></section>
    </div>
    <div class="col-md-4">
        <section class="card h-100"><div class="card-body"><h2 class="h4">Payments</h2><p>Check prepared and completed driver payments.</p><a asp-action="PaymentTracking" class="btn btn-primary">Track payments</a></div></section>
    </div>
</div>
